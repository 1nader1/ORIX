  "paths": {
    "/api/Design/analyze": {
      "post": {
        "tags": [
          "Design"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "palette": {
                    "type": "string"
                  },
                  "part": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "parts": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              },
              "encoding": {
                "image": {
                  "style": "form"
                },
                "palette": {
                  "style": "form"
                },
                "part": {
                  "style": "form"
                },
                "parts": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Design/generate": {
      "post": {
        "tags": [
          "Design"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "motion",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "layout",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DesignDocument"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DesignDocument"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DesignDocument"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedProject"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedProject"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedProject"
                }
              }
            }
          }
        }
      }
    },
    "/api/Design/download": {
